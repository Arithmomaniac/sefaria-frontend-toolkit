{
  "name": "@arithmomaniac/sefaria-web-components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arithmomaniac/sefaria-frontend-toolkit.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://github.com/Arithmomaniac/sefaria-frontend-toolkit#readme",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "custom-elements.json"
  ],
  "customElements": "./custom-elements.json",
  "sideEffects": [
    "./dist/index.js",
    "./dist/*-element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./acquisition": {
      "types": "./dist/acquisition.d.ts",
      "import": "./dist/acquisition.js"
    },
    "./bilingual-segment": {
      "types": "./dist/bilingual-segment-public.d.ts",
      "import": "./dist/bilingual-segment-public.js"
    },
    "./connections-panel": {
      "types": "./dist/connections-panel-public.d.ts",
      "import": "./dist/connections-panel-public.js"
    },
    "./popup": {
      "types": "./dist/popup-public.d.ts",
      "import": "./dist/popup-public.js"
    },
    "./reader": {
      "types": "./dist/reader-public.d.ts",
      "import": "./dist/reader-public.js"
    },
    "./reader-session": {
      "types": "./dist/reader-session-public.d.ts",
      "import": "./dist/reader-session-public.js"
    },
    "./ref-label": {
      "types": "./dist/ref-label-public.d.ts",
      "import": "./dist/ref-label-public.js"
    },
    "./source-card": {
      "types": "./dist/source-card-public.d.ts",
      "import": "./dist/source-card-public.js"
    },
    "./text-segment": {
      "types": "./dist/text-segment-public.d.ts",
      "import": "./dist/text-segment-public.js"
    }
  },
  "dependencies": {
    "@arithmomaniac/sefaria-client": "workspace:*",
    "@arithmomaniac/sefaria-text-transform": "workspace:*",
    "lit": "^3.3.3"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  }
}
